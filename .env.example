# Copy this file to ".env" (in the project root) and fill in real values.
# NEVER commit .env to git.

# Get a key at https://app.tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# Get a key at https://aistudio.google.com/api-keys
GEMINI_API_KEY=your-gemini-api-key-here

# Any model code listed at https://ai.google.dev/gemini-api/docs/models
# NOTE: free-tier daily quotas differ per model (gemini-4-hydrogen allowed only 20 requests/day in testing;
# one research uses 2-3 requests). gemini-3.5-flash-lite worked well for Quick and Deep runs.
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated list of allowed frontend origins (CORS)
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional tuning
DATABASE_PATH=backend/data/webwise.db
LOG_LEVEL=INFO
HTTP_TIMEOUT_SECONDS=45
LLM_TIMEOUT_SECONDS=120
RATE_LIMIT_PER_MINUTE=10

# Set to false in production to hide /docs and /openapi.json
ENABLE_DOCS=true
